# Cabeceras de seguridad HTTP reales para Cloudflare Pages.
# Se aplican a todas las rutas. Complementan (y superan) a los <meta> de
# index.html: X-Frame-Options, X-Content-Type-Options y la directiva
# frame-ancestors de la CSP solo funcionan como cabecera HTTP, no como meta.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://clientes.quintakooxtanil.com; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; frame-src https://www.google.com; connect-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
